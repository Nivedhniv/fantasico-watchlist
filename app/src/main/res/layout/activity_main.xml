<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorOnSurfaceInverse"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/toppanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:outlineAmbientShadowColor="@color/black"
            android:outlineProvider="none"
            android:visibility="gone"
            app:cardCornerRadius="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/greeting"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center"
                android:layout_marginStart="20dp"
                android:text="@string/greetings"
                android:textColor="?attr/colorPrimary"
                android:textSize="20sp"
                android:textStyle="bold"></TextView>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1">

            </View>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center"
                android:layout_marginEnd="20dp"
                app:cardCornerRadius="50dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_horizontal"
                    android:background="?attr/colorPrimary">

                    <ImageButton
                        android:id="@+id/searchpage"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_margin="5dp"
                        android:background="@drawable/search"
                        android:contentDescription="Search"></ImageButton>

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/account"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="5dp"
                        android:contentDescription="Profile"
                        android:scaleType="centerCrop"
                        android:src="@drawable/round_account_circle_24"
                        app:shapeAppearanceOverlay="@style/CircleImage" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/welcome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="150dp"
                android:orientation="vertical"
                android:padding="30dp">

                <TextView
                    android:id="@+id/msg"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:background="@drawable/chatbubble"
                    android:lines="3"
                    android:padding="10dp"
                    android:textColor="?attr/colorOnPrimary" />

                <ImageView
                    android:id="@+id/chip"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_gravity="start"
                    app:srcCompat="@drawable/waiting" />

                <EditText
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/cardlight"
                    android:hint="Name"
                    android:padding="10dp"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <Button
                    android:id="@+id/nameok"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="10dp"
                    android:text="Ok" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ProgressBar
                android:id="@+id/progressBar2"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="visible" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ScrollView
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/materialCardView"
                app:layout_constraintVertical_bias="0.0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include layout="@layout/new_releases" />

                    <TextView
                        android:id="@+id/one"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:paddingStart="20dp"
                        android:paddingEnd="0dp"
                        android:text="@string/watching"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold"></TextView>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:paddingStart="10dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/current"
                            android:layout_width="wrap_content"
                            android:layout_height="200dp"
                            android:orientation="horizontal"
                            android:paddingEnd="50dp">

                        </LinearLayout>
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/two"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:paddingStart="20dp"
                        android:paddingEnd="0dp"
                        android:text="Upcoming"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold"></TextView>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:paddingStart="10dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/upcoming"
                            android:layout_width="wrap_content"
                            android:layout_height="200dp"
                            android:orientation="horizontal"
                            android:paddingEnd="50dp">

                        </LinearLayout>
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/three"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:paddingStart="20dp"
                        android:paddingEnd="0dp"
                        android:text="@string/plan"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold"></TextView>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:paddingStart="10dp">

                        <LinearLayout
                            android:id="@+id/planwatch"
                            android:layout_width="wrap_content"
                            android:layout_height="200dp"
                            android:orientation="horizontal"
                            android:paddingEnd="50dp"
                            android:scrollbars="none">

                        </LinearLayout>
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/four"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:paddingStart="20dp"
                        android:paddingEnd="0dp"
                        android:text="@string/completed"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold"></TextView>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:paddingStart="10dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/completed"
                            android:layout_width="wrap_content"
                            android:layout_height="200dp"
                            android:orientation="horizontal"
                            android:paddingEnd="50dp">

                        </LinearLayout>

                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/five"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:paddingStart="20dp"
                        android:paddingEnd="0dp"
                        android:text="Dropped Shows"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold"></TextView>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="100dp"
                        android:paddingStart="10dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/dropped"
                            android:layout_width="wrap_content"
                            android:layout_height="200dp"
                            android:orientation="horizontal"
                            android:paddingEnd="50dp">

                        </LinearLayout>
                    </HorizontalScrollView>

                </LinearLayout>
            </ScrollView>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:src="@drawable/gradient" />
        </FrameLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/toptobtmgradient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
    </ImageView>
</androidx.constraintlayout.widget.ConstraintLayout>