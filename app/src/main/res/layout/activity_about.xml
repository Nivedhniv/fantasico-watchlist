<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:background="?attr/colorOnSurfaceInverse"
    android:layout_height="match_parent"
    tools:context=".About">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:orientation="vertical"
                        android:paddingTop="100dp"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:elevation="8dp"
                            android:padding="2dp"
                            android:background="@drawable/greengrad"
                            android:layout_margin="20dp"
                            android:layout_height="wrap_content">
                            <androidx.cardview.widget.CardView
                                android:layout_width="match_parent"
                                app:cardCornerRadius="18dp"
                                app:cardBackgroundColor="?attr/colorSecondaryContainer"
                                android:layout_height="match_parent">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:padding="10dp"
                                    android:orientation="horizontal">
                                    <ImageView
                                        android:layout_width="150dp"
                                        android:layout_height="150dp"
                                        android:src="@drawable/happy"/>
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="20dp"
                                        android:orientation="vertical">
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:textColor="?attr/colorPrimary"
                                            android:layout_height="wrap_content"
                                            android:text="DoWatch"
                                            android:textSize="30dp"
                                            android:textStyle="bold"/>

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:lines="4"
                                            android:textColor="?attr/colorOnPrimaryContainer"
                                            android:text="Your Destination
                                             For a Centralised Watchlist Application "
                                            android:textSize="15dp" />
                                    </LinearLayout>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:elevation="8dp"
                                android:orientation="vertical"
                                android:layout_marginStart="20dp"
                                android:gravity="start|center"
                                android:paddingStart="10dp"
                                android:layout_marginBottom="20dp"
                                android:background="@drawable/cardlight"
                                android:layout_height="100dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Version"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="20dp"
                                    android:textStyle="bold"
                                    android:padding="5dp"
                                    android:text="1.0.0"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Up to date"
                                    android:paddingStart="10dp"
                                    android:paddingEnd="10dp"
                                    android:padding="5dp"
                                    android:background="@drawable/radius"
                                    android:textColor="?attr/colorOnSecondary"
                                    android:backgroundTint="?attr/colorSecondary"/>
                            </LinearLayout>
                            <View
                                android:layout_width="20dp"
                                android:layout_height="0dp"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:elevation="8dp"
                                android:orientation="vertical"
                                android:layout_marginEnd="20dp"
                                android:gravity="start|center"
                                android:paddingStart="10dp"
                                android:layout_marginBottom="20dp"
                                android:background="@drawable/cardlight"
                                android:layout_height="100dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="License"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="20dp"
                                    android:textStyle="bold"
                                    android:padding="5dp"
                                    android:text="MIT"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Open source"
                                    android:padding="5dp"
                                    android:paddingStart="10dp"
                                    android:paddingEnd="10dp"
                                    android:background="@drawable/radius"
                                    android:textColor="?attr/colorOnTertiary"
                                    android:backgroundTint="?attr/colorTertiary"/>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:elevation="8dp"
                            android:layout_marginEnd="20dp"
                            android:layout_marginStart="20dp"
                            android:background="@drawable/cardlight"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:id="@+id/changelog"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="20dp">

                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingRight="10dp"
                                    app:srcCompat="@drawable/sparkle" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:textColor="?attr/colorOnPrimaryContainer"
                                    android:layout_height="wrap_content"
                                    android:text="Changelog"/>
                                <View
                                    android:layout_height="0dp"
                                    android:layout_width="0dp"
                                    android:layout_weight="1">
                                </View>
                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:srcCompat="@drawable/baseline_navigate_next_24">
                                </ImageView>
                            </LinearLayout>
                            <com.google.android.material.divider.MaterialDivider
                                android:layout_width="match_parent"
                                app:dividerInsetStart="16dp"
                                app:dividerInsetEnd="16dp"
                                android:alpha="0.5"
                                app:dividerColor="?attr/colorOnPrimaryContainer"
                                android:layout_height="wrap_content"/>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:id="@+id/help"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="20dp">
                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:paddingRight="10dp"
                                    android:layout_height="wrap_content"
                                    app:srcCompat="@drawable/baseline_help_24"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:textColor="?attr/colorOnPrimaryContainer"
                                    android:layout_height="wrap_content"
                                    android:text="Help Centre"/>
                                <View
                                    android:layout_height="0dp"
                                    android:layout_width="0dp"
                                    android:layout_weight="1">
                                </View>
                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:srcCompat="@drawable/baseline_navigate_next_24">
                                </ImageView>
                            </LinearLayout>
                            <com.google.android.material.divider.MaterialDivider
                                android:layout_width="match_parent"
                                app:dividerInsetStart="16dp"
                                app:dividerInsetEnd="16dp"
                                android:alpha="0.5"
                                app:dividerColor="?attr/colorOnPrimaryContainer"
                                android:layout_height="wrap_content"/>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:id="@+id/terms"
                                android:padding="20dp">
                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="10dp"
                                    app:srcCompat="@drawable/baseline_privacy_tip_24"
                                    />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="?attr/colorOnPrimaryContainer"
                                    android:text="@string/termstitle"/>
                                <View
                                    android:layout_height="0dp"
                                    android:layout_width="0dp"
                                    android:layout_weight="1">
                                </View>
                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:srcCompat="@drawable/baseline_navigate_next_24">
                                </ImageView>
                            </LinearLayout>
                            <com.google.android.material.divider.MaterialDivider
                                android:layout_width="match_parent"
                                app:dividerInsetStart="16dp"
                                android:alpha="0.5"
                                app:dividerInsetEnd="16dp"
                                app:dividerColor="?attr/colorOnPrimaryContainer"
                                android:layout_height="wrap_content"/>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:id="@+id/contact"
                                android:padding="20dp">
                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="10dp"
                                    app:srcCompat="@drawable/baseline_mail_24"
                                    />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="?attr/colorOnPrimaryContainer"
                                    android:text="Contact The Developer"/>
                                <View
                                    android:layout_height="0dp"
                                    android:layout_width="0dp"
                                    android:layout_weight="1">
                                </View>
                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:srcCompat="@drawable/baseline_navigate_next_24">
                                </ImageView>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_margin="20dp"
                            android:elevation="8dp"
                            android:background="@drawable/radius"
                            android:backgroundTint="?attr/colorTertiary"
                            android:id="@+id/Github"
                            android:gravity="center"
                            android:padding="20dp">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginRight="10dp"
                                app:srcCompat="@drawable/github_142"
                                />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnTertiary"
                                android:text="View On GitHub"/>
                        </LinearLayout>
                    </LinearLayout>
            </ScrollView>

        <ImageButton
            android:id="@+id/Back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|top"
            android:layout_margin="30dp"
            android:layout_marginLeft="16dp"
            android:background="@color/transparent"
            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="@drawable/baseline_arrow_back_ios_24" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>