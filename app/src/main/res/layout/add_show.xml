<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="@color/transparent"
    android:padding="10dp"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card"
        android:backgroundTint="?attr/colorOnSurfaceInverse"
        android:elevation="8dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.454"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="70dp">

            <TextView
                android:id="@+id/textView4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="Add Show"
                android:textSize="20sp" />

            <ImageButton
                android:id="@+id/closeBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="10dp"
                android:background="@android:color/transparent"
                android:src="@drawable/baseline_close_24"
                android:contentDescription="Close" />

        </FrameLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="460dp"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingBottom="20dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/imagePicker"
                        android:layout_width="150dp"
                        android:layout_height="250dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="20dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="?attr/colorSurfaceContainer"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/posterurl"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/titleform"
                        android:padding="10dp"
                        android:maxLines="3"
                        android:text="Show title"
                        android:textSize="20dp"
                        android:gravity="center">
                    </TextView>
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="0dp"
                            android:hint="Select Status"
                            style="@style/Widget.Material3.TextInputLayout.FilledBox.Dense.ExposedDropdownMenu">
                            <AutoCompleteTextView
                                android:id="@+id/status"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:inputType="none">
                            </AutoCompleteTextView>
                        </com.google.android.material.textfield.TextInputLayout>
                    <LinearLayout
                        android:id="@+id/ratingSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rate the Show"
                            android:layout_gravity="start"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp" />

                        <RatingBar
                            android:id="@+id/ratingBar"
                            android:layout_width="wrap_content"
                            android:layout_gravity="center"
                            android:layout_height="wrap_content"
                            android:numStars="5"
                            android:stepSize="1"
                            android:scaleY="1.3"
                            android:scaleX="1.3" />

                    </LinearLayout>


                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/datearea"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Show will Air on">

                            <EditText
                                android:id="@+id/date"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:focusable="false"
                                android:clickable="true"
                                android:cursorVisible="false"
                                android:layout_marginBottom="20dp" />
                        </com.google.android.material.textfield.TextInputLayout>


                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/reviewsection"
                            android:hint="Add Show Review"
                            android:layout_marginBottom="20dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:id="@+id/review"
                            android:layout_height="120dp"
                            android:layout_marginBottom="20dp"
                            android:gravity="top|start"
                            android:inputType="textMultiLine"
                            android:scrollbars="vertical">
                        </com.google.android.material.textfield.TextInputEditText>
                        </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>


            </ScrollView>

        <Button
            android:id="@+id/Addmovie"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:backgroundTint="?attr/colorPrimary"
            android:layout_margin="20dp"
            android:layout_gravity="end"
            android:padding="10dp"
            android:text="Add Show"
            />
        </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>