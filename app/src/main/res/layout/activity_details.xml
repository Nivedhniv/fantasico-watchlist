<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorOnSurfaceInverse"
    tools:context=".Account">
    <FrameLayout
        android:layout_width="match_parent"
        android:id="@+id/loading"
        android:layout_height="match_parent">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progressBar2"
            android:visibility="visible"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:indeterminate="true"
            android:layout_height="wrap_content" />
    </FrameLayout>
    <FrameLayout
        android:id="@+id/content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="match_parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="250dp">
                <ImageView
                    android:id="@+id/header"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#66000000" />

            </FrameLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:layout_height="wrap_content">
                    <ScrollView
                        android:layout_width="200dp"
                        android:layout_marginStart="180dp"
                        android:layout_height="100dp"
                        android:layout_marginTop="10dp"
                        >
                        <TextView
                            android:id="@+id/title"
                            android:layout_width="180dp"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="20sp"
                            android:paddingTop="2dp"
                            android:text="Movie title"/>
                    </ScrollView>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:orientation="horizontal"
                        android:id="@+id/smalldetails"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:gravity="center_vertical"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:textSize="15sp"
                            android:id="@+id/year"
                            android:text="2020"
                            android:layout_height="wrap_content" />
                        <View
                            android:layout_width="1dp"
                            android:layout_height="10dp"
                            android:layout_marginStart="10dp"
                            android:background="?attr/colorOnBackground"/>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:scaleX="0.8"
                                android:scaleY="0.8"
                                android:layout_marginLeft="10dp"
                                android:layout_marginRight="5dp"
                                android:background="@drawable/baseline_star_24" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/rating"
                                android:textSize="15sp"
                                android:text="7"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <View
                            android:layout_width="1dp"
                            android:layout_height="10dp"
                            android:layout_margin="20dp"
                            android:background="?attr/colorOnBackground"/>
                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none"
                            android:orientation="horizontal" >
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:id="@+id/genreContainer">
                            </LinearLayout>
                        </HorizontalScrollView>
                    </LinearLayout>
                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:orientation="vertical"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="match_parent"
                                android:textSize="15sp"
                                android:paddingStart="25dp"
                                android:paddingBottom="10dp"
                                android:textStyle="bold"
                                android:text="About"
                                android:layout_height="wrap_content" />
                            <TextView
                                android:layout_width="match_parent"
                                android:textSize="15sp"
                                android:id="@+id/about"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="20dp"
                                android:layout_marginRight="20dp"
                                android:background="@drawable/cardlight"
                                android:padding="20dp"/>
                        </LinearLayout>
                    </ScrollView>

                </LinearLayout>

        </LinearLayout>

        <ImageButton
            android:id="@+id/Back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|top"
            android:layout_margin="30dp"
            android:contentDescription="star"
            android:background="@color/transparent"
            android:layout_marginLeft="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="@drawable/baseline_arrow_back_ios_24" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="150dp"
            android:id="@+id/posterCard"
            android:layout_height="200dp"
            android:layout_gravity="start|top"
            android:layout_marginTop="110dp"
            android:layout_marginStart="20dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:id="@+id/poster"
            android:elevation="5dp" />
    </com.google.android.material.card.MaterialCardView>
        <View
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_gravity="bottom"
            android:background="@drawable/toptobtmgradient"/>
        <Button
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:id="@+id/addbtn"
            android:layout_margin="30dp"
            android:text="Add To Watchlist"
            android:contentDescription="watchlist add btn"
            android:layout_gravity="bottom|end"
            app:srcCompat="@drawable/baseline_add_24"
            android:background="@drawable/searchbar">
        </Button>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>