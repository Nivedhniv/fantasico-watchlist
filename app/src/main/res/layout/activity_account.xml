<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorOnSurfaceInverse"
    tools:context=".Account">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:layout_marginTop="60dp">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="170dp"
                            android:elevation="8dp"
                            android:layout_margin="20dp"
                            app:cardCornerRadius="20dp"
                            android:backgroundTint="?attr/colorSecondaryContainer"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="horizontal">
                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    app:cardCornerRadius="0dp"
                                    app:cardElevation="0dp"
                                    app:strokeWidth="0dp">
                                    <ImageView
                                        android:id="@+id/imageView2"
                                        android:layout_width="140dp"
                                        android:layout_height="match_parent"
                                        android:layout_gravity="center"
                                        android:scaleType="centerCrop"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent" />
                                    <View
                                        android:layout_width="30dp"
                                        android:background="@drawable/leftrightgrad"
                                        android:layout_height="match_parent"
                                        android:layout_gravity="end"/>
                                </com.google.android.material.card.MaterialCardView>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="20dp"
                                    android:layout_gravity="end"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/name"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Name"
                                        android:maxLines="2"
                                        android:textColor="?attr/colorOnSecondaryContainer"
                                        android:textSize="25dp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/usrbadge"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="10dp"
                                        android:text="Pro Entertainment"
                                        android:textColor="?attr/colorPrimary"
                                        android:textSize="15dp"
                                        android:textStyle="bold" />

                                    <View
                                        android:layout_width="0dp"
                                        android:layout_height="0dp"
                                        android:layout_weight="1" />

                                    <LinearLayout
                                        android:id="@+id/editbtn"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="end"
                                        android:background="@drawable/radius"
                                        android:backgroundTint="?attr/colorPrimary"
                                        android:clickable="true"
                                        android:gravity="center"
                                        android:hapticFeedbackEnabled="true"
                                        android:orientation="horizontal"
                                        android:padding="5dp">

                                        <ImageView
                                            android:layout_width="wrap_content"
                                            android:layout_height="15dp"
                                            android:src="@drawable/editlight" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Edit Profile"
                                            android:textColor="?attr/colorOnPrimary" />
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                        <TextView
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:text="Dashboard"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:elevation="8dp"
                            android:padding="10dp"
                            android:gravity="center_horizontal"
                            android:layout_margin="20dp"
                            android:background="@drawable/card_withborder"
                            android:orientation="horizontal">
                            <androidx.gridlayout.widget.GridLayout
                                android:layout_height="wrap_content"
                                android:layout_width="match_parent"
                                app:columnCount="3"
                                app:alignmentMode="alignMargins"
                                app:useDefaultMargins="true">
                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    app:layout_columnWeight="1"
                                    app:cardCornerRadius="10dp"
                                    android:backgroundTint="?attr/colorPrimary">
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:paddingTop="10dp"
                                        android:paddingBottom="10dp"
                                        android:orientation="vertical">
                                        <TextView
                                            android:layout_width="match_parent"
                                            android:textStyle="bold"
                                            android:textColor="?attr/colorOnPrimary"
                                            android:layout_height="wrap_content"
                                            android:paddingBottom="10dp"
                                            android:lines="2"
                                            android:textAlignment="center"
                                            android:text="Total Titles"/>
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:textColor="?attr/colorOnPrimary"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="bottom|center_horizontal"
                                            android:textSize="25dp"
                                            android:id="@+id/totalTitlesCount"/>
                                    </LinearLayout>
                                </com.google.android.material.card.MaterialCardView>
                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    app:layout_columnWeight="1"
                                    app:cardCornerRadius="10dp"
                                    android:backgroundTint="?attr/colorPrimary">
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:paddingTop="10dp"
                                        android:paddingBottom="10dp"
                                        android:orientation="vertical">
                                        <TextView
                                            android:layout_width="match_parent"
                                            android:textStyle="bold"
                                            android:textColor="?attr/colorOnPrimary"
                                            android:layout_height="wrap_content"
                                            android:paddingBottom="10dp"
                                            android:textAlignment="center"
                                            android:text="Currently Watching"/>
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:textColor="?attr/colorOnPrimary"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="bottom|center_horizontal"
                                            android:textSize="25dp"
                                            android:id="@+id/watchingCount"/>
                                    </LinearLayout>
                                </com.google.android.material.card.MaterialCardView>
                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    app:layout_columnWeight="1"
                                    app:cardCornerRadius="10dp"
                                    android:backgroundTint="?attr/colorPrimary">
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:paddingTop="10dp"
                                        android:paddingBottom="10dp"
                                        android:orientation="vertical">
                                        <TextView
                                            android:layout_width="match_parent"
                                            android:textStyle="bold"
                                            android:textColor="?attr/colorOnPrimary"
                                            android:layout_height="wrap_content"
                                            android:paddingBottom="10dp"
                                            android:lines="2"
                                            android:textAlignment="center"
                                            android:text="Completed"/>
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:textColor="?attr/colorOnPrimary"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="bottom|center_horizontal"
                                            android:textSize="25dp"
                                            android:id="@+id/completedCount"/>
                                    </LinearLayout>
                                </com.google.android.material.card.MaterialCardView>
                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    app:layout_columnWeight="1"
                                    app:cardCornerRadius="10dp"
                                    android:backgroundTint="?attr/colorPrimary">
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:paddingTop="10dp"
                                        android:paddingBottom="10dp"
                                        android:orientation="vertical">
                                        <TextView
                                            android:layout_width="match_parent"
                                            android:textStyle="bold"
                                            android:lines="2"
                                            android:textColor="?attr/colorOnPrimary"
                                            android:layout_height="wrap_content"
                                            android:paddingBottom="10dp"
                                            android:textAlignment="center"
                                            android:text="Plan To       Watch"/>
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:textColor="?attr/colorOnPrimary"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="bottom|center_horizontal"
                                            android:textSize="25dp"
                                            android:id="@+id/planToWatchCount"/>
                                    </LinearLayout>
                                </com.google.android.material.card.MaterialCardView>
                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    app:layout_columnWeight="1"
                                    app:cardCornerRadius="10dp"
                                    android:backgroundTint="?attr/colorPrimary">
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:paddingTop="10dp"
                                        android:paddingBottom="10dp"
                                        android:orientation="vertical">
                                        <TextView
                                            android:layout_width="match_parent"
                                            android:textStyle="bold"
                                            android:lines="2"
                                            android:textColor="?attr/colorOnPrimary"
                                            android:layout_height="wrap_content"
                                            android:paddingBottom="10dp"
                                            android:textAlignment="center"
                                            android:text="Upcoming"/>
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:textColor="?attr/colorOnPrimary"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="bottom|center_horizontal"
                                            android:textSize="25dp"
                                            android:id="@+id/upcomingCount"/>
                                    </LinearLayout>
                                </com.google.android.material.card.MaterialCardView>
                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    app:layout_columnWeight="1"
                                    app:cardCornerRadius="10dp"
                                    android:backgroundTint="?attr/colorPrimary">
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:paddingTop="10dp"
                                        android:paddingBottom="10dp"
                                        android:orientation="vertical">
                                        <TextView
                                            android:layout_width="match_parent"
                                            android:textStyle="bold"
                                            android:textColor="?attr/colorOnPrimary"
                                            android:layout_height="wrap_content"
                                            android:paddingBottom="10dp"
                                            android:textAlignment="center"
                                            android:text="Dropped"
                                            android:lines="2"/>
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:textColor="?attr/colorOnPrimary"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="bottom|center_horizontal"
                                            android:textSize="25dp"
                                            android:id="@+id/droppedCount"/>
                                    </LinearLayout>
                                </com.google.android.material.card.MaterialCardView>
                            </androidx.gridlayout.widget.GridLayout>
                        </LinearLayout>
                        <!--support area-->
                        <TextView
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:text="Others"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:elevation="8dp"
                            android:layout_margin="20dp"
                            android:background="@drawable/cardlight"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:clickable="true"
                                android:id="@+id/about"
                                android:padding="20dp">
                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="10dp"
                                    app:srcCompat="@drawable/info"
                                    />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="?attr/colorOnPrimaryContainer"
                                    android:text="About Us"/>
                                <View
                                    android:layout_height="0dp"
                                    android:layout_width="0dp"
                                    android:layout_weight="1">
                                </View>
                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:srcCompat="@drawable/baseline_navigate_next_24"
                                    >
                                </ImageView>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
            <ImageButton
                android:id="@+id/Back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|top"
                android:layout_margin="30dp"
                android:background="@color/transparent"
                android:layout_marginLeft="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:srcCompat="@drawable/baseline_arrow_back_ios_24" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:id="@+id/overlay"
                android:background="#80000000" />
            <LinearLayout
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:id="@+id/editcard"
                android:padding="20dp"
                android:background="@drawable/cardlight"
                android:orientation="vertical">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="130dp"
                    android:layout_gravity="center"
                    android:clickable="true"
                    android:id="@+id/profileImageCard"
                    app:cardCornerRadius="100dp"
                    android:layout_height="130dp">
                    <ImageView
                        android:id="@+id/imgselected"
                        android:layout_width="match_parent"
                        android:scaleType="centerCrop"
                        android:layout_height="match_parent"
                        android:background="?attr/colorPrimary"
                        android:layout_gravity="center"
                        />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#66000000" />
                    <TextView
                        android:layout_width="50dp"
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:id="@+id/taptext"
                        android:textColor="@color/white"
                        android:layout_height="wrap_content"
                        android:text="Tap to edit"/>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginTop="10dp"
                    android:id="@+id/reviewsection"
                    android:hint="Username">
                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:id="@+id/usrname"
                        android:layout_height="wrap_content"
                        android:scrollbars="vertical">
                    </com.google.android.material.textfield.TextInputEditText>
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/upno"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/cancelReview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cancel" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <Button
                        android:id="@+id/updateReview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Update" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>