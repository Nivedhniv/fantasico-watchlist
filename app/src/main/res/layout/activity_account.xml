<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorOnSurfaceInverse"
    tools:context=".Account">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="60dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:elevation="8dp"
                    android:layout_margin="20dp"
                    android:background="@drawable/cardlight"
                    android:padding="20dp"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        app:cardCornerRadius="100dp"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/imageView2"
                            android:layout_width="126dp"
                            android:layout_height="131dp"
                            android:layout_gravity="center"
                            android:scaleType="centerCrop"
                            android:background="@drawable/searchbar"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/round_account_circle_24" />
                    </androidx.cardview.widget.CardView>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:paddingStart="20dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:textStyle="bold"
                            android:textSize="25dp"
                            android:id="@+id/name"
                            android:text="Name"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="?attr/colorPrimary"
                            android:textStyle="bold"
                            android:textSize="15dp"
                            android:id="@+id/usrbadge"
                            android:text="Pro Entertainment"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>
                        <LinearLayout
                            android:id="@+id/editbtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:backgroundTint="?attr/colorPrimaryContainer"
                            android:background="@drawable/card_withborder"
                            android:src="@drawable/edit"
                            android:clickable="true"
                            android:padding="5dp"
                            android:hapticFeedbackEnabled="true"
                            android:gravity="center"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="15dp"
                                android:src="@drawable/edit"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Edit Profile"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!--support area-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:elevation="8dp"
                android:layout_margin="20dp"
                android:background="@drawable/cardlight"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:id="@+id/help"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:paddingRight="10dp"
                        android:layout_height="wrap_content"
                        app:srcCompat="@drawable/baseline_help_24"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:layout_height="wrap_content"
                        android:text="Help Centre"/>
                    <View
                        android:layout_height="0dp"
                        android:layout_width="0dp"
                        android:layout_weight="1">
                    </View>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:srcCompat="@drawable/baseline_navigate_next_24">
                    </ImageView>
                </LinearLayout>
                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    app:dividerInsetStart="16dp"
                    app:dividerInsetEnd="16dp"
                    app:dividerColor="?attr/colorOnPrimaryContainer"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:id="@+id/terms"
                    android:padding="20dp">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        app:srcCompat="@drawable/terms"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:text="@string/termstitle"/>
                    <View
                        android:layout_height="0dp"
                        android:layout_width="0dp"
                        android:layout_weight="1">
                    </View>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:srcCompat="@drawable/baseline_navigate_next_24"
                        >
                    </ImageView>
                </LinearLayout>

            </LinearLayout>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1">

            </View>
            </LinearLayout>

            <ImageButton
                android:id="@+id/Back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|top"
                android:layout_margin="30dp"
                android:background="@color/transparent"
                android:layout_marginLeft="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:srcCompat="@drawable/baseline_arrow_back_ios_24" />
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:id="@+id/overlay"
                android:background="#80000000" />
            <LinearLayout
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:id="@+id/editcard"
                android:padding="20dp"
                android:background="@drawable/cardlight"
                android:orientation="vertical">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="130dp"
                    android:layout_gravity="center"
                    android:clickable="true"
                    android:id="@+id/profileImageCard"
                    app:cardCornerRadius="100dp"
                    android:layout_height="130dp">
                    <ImageView
                        android:id="@+id/imgselected"
                        android:layout_width="match_parent"
                        android:scaleType="centerCrop"
                        android:layout_height="match_parent"
                        android:background="?attr/colorPrimary"
                        android:layout_gravity="center"
                        />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#66000000" />
                    <TextView
                        android:layout_width="50dp"
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:id="@+id/taptext"
                        android:textColor="?attr/colorPrimary"
                        android:layout_height="wrap_content"
                        android:text="Tap to edit"/>
                </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginTop="10dp"
                        android:id="@+id/reviewsection"
                        android:hint="Username">
                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:id="@+id/usrname"
                            android:layout_height="wrap_content"
                            android:scrollbars="vertical">
                        </com.google.android.material.textfield.TextInputEditText>
                    </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/upno"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/cancelReview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cancel" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <Button
                        android:id="@+id/updateReview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Update" />
                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>